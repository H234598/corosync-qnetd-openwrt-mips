# Local SDK state and generated output, at any depth.
sdk-state/
output/
artifacts/
dist/
build-logs/
logs/
*.log
__pycache__/
*.py[cod]

# Per-installation NSS stores must never enter source control.
nssdb/
nssdb-*/
nssdb_*/
cert8.db
cert9.db
key3.db
key4.db
secmod.db
pkcs11.txt
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local credentials, keys, certificates and environment files.
.env*
*.key
*.pem
*.p12
*.pfx
*.p7b
*.p7c
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
secrets/
secret/
private/

# Local deployment settings, backup copies and generated archives.
.local/
local-deploy/
deploy-local/
local-config/
*.local
*.local.*
backup/
backups/
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*.zip
*.tar
*.tgz
*.txz
*.tbz
*.tbz2
*.gz
*.bz2
*.xz
*.zst
*.7z
*.rar
*.apk
*.ipk
*.deb
*.rpm
